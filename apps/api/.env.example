# ---------- Database (Supabase Postgres — used as plain Postgres via Prisma, NOT via Supabase client/RLS) ----------
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (port 5432, "Session"/direct, NOT the 6543 pooler)
# If your password has special characters (@ : / ? # etc.), percent-encode them (e.g. "p@ss" -> "p%40ss")
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.alfokhlyoitokzkahgce.supabase.co:5432/postgres"

# ---------- JWT ----------
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------- Supabase Storage (server-side only — buckets already exist: avatars, products, offers, stores) ----------
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://alfokhlyoitokzkahgce.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Stripe ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"

# ---------- App ----------
PORT=4000
CORS_ORIGIN="http://localhost:3000"

