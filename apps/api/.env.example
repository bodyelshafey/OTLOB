# ---------- Database (Supabase Postgres — used as plain Postgres via Prisma, NOT via Supabase client/RLS) ----------
# Two URLs are used for two different purposes — this is the Prisma-documented,
# Supabase-recommended pattern for Prisma 7 + @prisma/adapter-pg + Supavisor:
#
# DATABASE_URL — the RUNTIME connection used by PrismaService (via PrismaPg).
#   Use the Supavisor "Transaction" pooler (port 6543), with `?pgbouncer=true`
#   appended — that flag disables Prisma's named prepared statements, which
#   transaction-mode pooling does not support. Get it from Supabase Dashboard
#   -> Project Settings -> Database -> Connection string -> "Transaction pooler".
#   Safe for this app's usage: $transaction() calls work fine under
#   transaction-mode pooling (each transaction gets a connection for its
#   duration, which is exactly what transaction mode provides).
#
# DIRECT_URL — used ONLY by the Prisma CLI (prisma.config.ts) for
#   `prisma migrate` / `prisma generate`, which need a direct connection
#   (migrations use advisory locks and DDL that pooled connections don't
#   support reliably). Port 5432, "Session"/direct connection string.
#
# If your password has special characters (@ : / ? # etc.), percent-encode
# them (e.g. "p@ss" -> "p%40ss").
DATABASE_URL="postgresql://postgres.alfokhlyoitokzkahgce:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:YOUR-PASSWORD@db.alfokhlyoitokzkahgce.supabase.co:5432/postgres"

# ---------- JWT ----------
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ---------- Supabase Storage (server-side only — buckets already exist: avatars, products, offers, stores) ----------
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://alfokhlyoitokzkahgce.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---------- Email (verification codes — works with any SMTP provider: Gmail, SendGrid, SES, Resend, etc.) ----------
# NOTE: email/phone verification is currently DISABLED for registration
# (see AuthService.register) — SMTP is only actually used by the still-live
# forgot/reset-password flow (and by verify-email/add-phone if you turn
# verification back on). If left unset, codes are logged to the server
# console instead of emailed (fine for local dev/testing).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="OTLOB <no-reply@otlob.app>"

# Registration no longer sends an OTP, so instead of confirming a mailbox
# via email, it checks the domain actually has mail-exchange capability
# (MX / A / AAAA record) and rejects a short built-in list of disposable
# domains — see AuthService.validateEmailDomain. Set to "true" to skip this
# (e.g. local dev without reliable outbound DNS). Leave unset/"false" in
# production.
SKIP_EMAIL_DOMAIN_CHECK="false"

# ---------- SMS / WhatsApp (phone verification codes) ----------
# NOTE: phone verification is currently DISABLED for registration (see
# AuthService.register) and not offered automatically anywhere in the
# clients — the add-phone/verify-phone endpoints and this provider still
# exist and work if called directly, for turning it back on later.
# If left unset (or SMS_PROVIDER isn't "twilio"), codes are logged to the
# server console instead of texted (fine for local dev/testing). To send
# real SMS/WhatsApp via Twilio: set SMS_PROVIDER="twilio" and fill in the
# three TWILIO_* vars. For WhatsApp specifically, set TWILIO_FROM_NUMBER to
# a "whatsapp:+1415..." sender (see apps/api/src/modules/auth/providers/sms.provider.ts).
# A different vendor can be added later by implementing the SmsProvider
# interface in that same file — no other auth code needs to change.
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ---------- Google Sign-In ----------
# OAuth 2.0 Client ID from Google Cloud Console (APIs & Services ->
# Credentials). Used server-side ONLY to verify the audience of ID tokens
# sent by the web/mobile clients to POST /auth/google — never a client
# secret. If unset, /auth/google returns 400 instead of silently accepting
# unverifiable tokens. The web/mobile clients need their OWN client IDs
# configured too (NEXT_PUBLIC_GOOGLE_CLIENT_ID for web; see apps/app's env
# section below for mobile) — Google issues a separate client ID per
# platform, but they can all share one OAuth consent screen/project.
GOOGLE_CLIENT_ID=""

# ---------- Sentry (error tracking — optional; a no-op when unset) ----------
SENTRY_DSN=""

# ---------- Stripe ----------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"
# BullMQ worker concurrency — how many jobs each queue processes at once.
# See apps/api/src/config/queue.config.ts for the reasoning behind these defaults.
NOTIFICATIONS_QUEUE_CONCURRENCY="5"
REPORTS_QUEUE_CONCURRENCY="2"

# ---------- App ----------
PORT=4000
CORS_ORIGIN="http://localhost:3000"

