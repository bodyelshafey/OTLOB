generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  STORE_OWNER
  EMPLOYEE
  DRIVER
  ADMIN
  SUPER_ADMIN
}

enum StoreMemberRole {
  OWNER
  MANAGER
  CASHIER
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  DELIVERING
  COMPLETED
  CANCELLED
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
}

// Shared review lifecycle for anything that needs admin sign-off before it
// can go public (featured offers, ads). PENDING is the natural starting
// state once a store owner requests homepage placement / creates an ad.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// IDENTITY
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(uuid())
  fullName      String   @map("full_name")
  email         String   @unique
  phone         String?  @unique
  passwordHash  String   @map("password_hash")
  avatar        String?
  role          UserRole @default(USER)
  isActive      Boolean  @default(true) @map("is_active")
  isVerified    Boolean  @default(false) @map("is_verified")
  refreshToken  String?  @map("refresh_token")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  stores        Store[]        @relation("StoreOwner")
  storeMembers  StoreMember[]
  addresses     Address[]
  cartItems     CartItem[]
  orders        Order[]
  reviews       Review[]
  favorites     Favorite[]
  notifications Notification[]
  driver        Driver?
  auditLogs     AuditLog[]
  verificationCodes VerificationCode[]
  pushTokens        PushToken[]
  reviewedOffers    Offer[]            @relation("OfferReviewedBy")
  reviewedAds       Ad[]               @relation("AdReviewedBy")

  @@map("users")
}

model VerificationCode {
  id         String    @id @default(uuid())
  user       User      @relation(fields: [userId], references: [id])
  userId     String    @map("user_id")
  // Hashed the same way passwords are (argon2) — never store the raw code.
  codeHash   String    @map("code_hash")
  // Single purpose today ("EMAIL_VERIFICATION"); kept as a plain string
  // instead of a new enum so a future purpose (e.g. password reset) doesn't
  // need a schema-level enum migration, just a new string value.
  purpose    String    @default("EMAIL_VERIFICATION")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("verification_codes")
}

model Driver {
  id            String       @id @default(uuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String       @unique @map("user_id")
  vehicleType   String?      @map("vehicle_type")
  plateNumber   String?      @map("plate_number")
  status        DriverStatus @default(OFFLINE)
  currentLat    Float?       @map("current_lat")
  currentLng    Float?       @map("current_lng")
  isApproved    Boolean      @default(false) @map("is_approved")
  createdAt     DateTime     @default(now()) @map("created_at")

  orders        Order[]

  @@map("drivers")
}

// ---------------------------------------------------------------------------
// CATALOG
// ---------------------------------------------------------------------------

model StoreType {
  id        String   @id @default(uuid())
  nameAr    String   @map("name_ar")
  nameEn    String   @map("name_en")
  image     String?
  createdAt DateTime @default(now()) @map("created_at")

  stores     Store[]
  categories Category[]

  @@map("store_types")
}

model Store {
  id             String    @id @default(uuid())
  owner          User      @relation("StoreOwner", fields: [ownerId], references: [id])
  ownerId        String    @map("owner_id")
  storeType      StoreType @relation(fields: [storeTypeId], references: [id])
  storeTypeId    String    @map("store_type_id")
  name           String
  description    String?
  image          String?
  coverImage     String?   @map("cover_image")
  rating         Decimal   @default(0) @db.Decimal(2, 1)
  deliveryTime   String?   @map("delivery_time")
  deliveryFee    Decimal   @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  minimumOrder   Decimal   @default(0) @map("minimum_order") @db.Decimal(10, 2)
  isOpen         Boolean   @default(true) @map("is_open")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  // Overrides the global "ad_monthly_limit_default" Setting for this store
  // specifically. Null = use the global default.
  monthlyAdLimitOverride Int? @map("monthly_ad_limit_override")

  members        StoreMember[]
  categories     Category[]
  products       Product[]
  offers         Offer[]
  orders         Order[]
  reviews        Review[]
  favorites      Favorite[]
  ads            Ad[]
  banners        Banner[]
  settings       StoreSettings?
  workingHours   WorkingHour[]
  dailyStats     StoreDailyStat[]

  @@map("stores")
}

model StoreMember {
  id        String          @id @default(uuid())
  store     Store           @relation(fields: [storeId], references: [id])
  storeId   String          @map("store_id")
  user      User            @relation(fields: [userId], references: [id])
  userId    String          @map("user_id")
  role      StoreMemberRole @default(CASHIER)
  createdAt DateTime        @default(now()) @map("created_at")

  @@unique([storeId, userId])
  @@map("store_members")
}

model Category {
  id          String    @id @default(uuid())
  store       Store?    @relation(fields: [storeId], references: [id])
  storeId     String?   @map("store_id")
  storeType   StoreType @relation(fields: [storeTypeId], references: [id])
  storeTypeId String    @map("store_type_id")
  nameAr      String    @map("name_ar")
  nameEn      String    @map("name_en")
  image       String?
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  products Product[]

  @@index([storeId, isActive, sortOrder])
  @@map("categories")
}

model Product {
  id          String   @id @default(uuid())
  store       Store    @relation(fields: [storeId], references: [id])
  storeId     String   @map("store_id")
  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String   @map("category_id")
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  image       String?
  isAvailable Boolean  @default(true) @map("is_available")
  isDeleted   Boolean  @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  images      ProductImage[]
  cartItems   CartItem[]
  orderItems  OrderItem[]
  favorites   Favorite[]
  offers      Offer[]

  @@map("products")
}

model ProductImage {
  id        String  @id @default(uuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id")
  url       String

  @@map("product_images")
}

model Offer {
  id                 String    @id @default(uuid())
  store               Store     @relation(fields: [storeId], references: [id])
  storeId             String    @map("store_id")
  titleAr             String    @map("title_ar")
  titleEn             String    @map("title_en")
  descriptionAr       String?   @map("description_ar")
  descriptionEn       String?   @map("description_en")
  image               String?
  oldPrice            Decimal?  @map("old_price") @db.Decimal(10, 2)
  newPrice            Decimal?  @map("new_price") @db.Decimal(10, 2)
  discountPercentage  Decimal?  @map("discount_percentage") @db.Decimal(5, 2)
  isActive            Boolean   @default(true) @map("is_active")
  startsAt            DateTime? @map("starts_at")
  endsAt              DateTime? @map("ends_at")
  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  // These three columns already existed on the live Supabase table before
  // this migration (product_id, is_featured_home, display_order) — an
  // earlier, never-finished attempt at featured offers that had no Prisma
  // model or service code behind it. Reusing them here rather than adding
  // a parallel "kind" concept, per Abdo's direction.
  product           Product?       @relation(fields: [productId], references: [id])
  productId         String?        @map("product_id")
  // A normal offer never sets this. A store owner sets it to request
  // homepage placement — that request then needs approvalStatus=APPROVED
  // before it's actually homepage-eligible (see OffersService).
  isFeaturedHome    Boolean        @default(false) @map("is_featured_home")
  displayOrder      Int            @default(0) @map("display_order")
  approvalStatus    ApprovalStatus @default(APPROVED) @map("approval_status")
  rejectionReason   String?        @map("rejection_reason")
  reviewedBy        User?          @relation("OfferReviewedBy", fields: [reviewedById], references: [id])
  reviewedById      String?        @map("reviewed_by_id")
  reviewedAt        DateTime?      @map("reviewed_at")

  // All optional — a store owner can create a valid offer with just the
  // fields above. These exist purely for an owner who wants to add richer
  // detail (what's included, conditions, a cap on redemptions).
  includedItems String? @map("included_items")
  conditions    String?
  quantityLimit Int?    @map("quantity_limit")

  cartItems  CartItem[]
  orderItems OrderItem[]

  // Homepage "Today's Offers" query filters on exactly this combination.
  @@index([isFeaturedHome, approvalStatus, isActive])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// LOCATION
// ---------------------------------------------------------------------------

model Zone {
  id     String @id @default(uuid())
  nameAr String @map("name_ar")
  nameEn String @map("name_en")

  districts     District[]
  deliveryZones DeliveryZone[]

  @@map("zones")
}

model District {
  id     String @id @default(uuid())
  zone   Zone   @relation(fields: [zoneId], references: [id])
  zoneId String @map("zone_id")
  nameAr String @map("name_ar")
  nameEn String @map("name_en")

  addresses Address[]

  @@map("districts")
}

model DeliveryZone {
  id           String  @id @default(uuid())
  zone         Zone    @relation(fields: [zoneId], references: [id])
  zoneId       String  @map("zone_id")
  deliveryFee  Decimal @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  isActive     Boolean @default(true) @map("is_active")

  @@map("delivery_zones")
}

model Address {
  id          String   @id @default(uuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @map("user_id")
  district    District @relation(fields: [districtId], references: [id])
  districtId  String   @map("district_id")
  label       String?
  fullAddress String   @map("full_address")
  lat         Float?
  lng         Float?
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("addresses")
}

// ---------------------------------------------------------------------------
// CART
// ---------------------------------------------------------------------------

model CartItem {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id")
  product   Product? @relation(fields: [productId], references: [id])
  productId String?  @map("product_id")
  offer     Offer?   @relation(fields: [offerId], references: [id])
  offerId   String?  @map("offer_id")
  quantity  Int      @default(1)
  note      String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// ORDERS
// ---------------------------------------------------------------------------

model Order {
  id             String        @id @default(uuid())
  user           User          @relation(fields: [userId], references: [id])
  userId         String        @map("user_id")
  store          Store         @relation(fields: [storeId], references: [id])
  storeId        String        @map("store_id")
  driver         Driver?       @relation(fields: [driverId], references: [id])
  driverId       String?       @map("driver_id")
  address        Address?      @relation(fields: [addressId], references: [id])
  addressId      String?       @map("address_id")
  customerName   String        @map("customer_name")
  phone          String
  fullAddress    String        @map("full_address")
  paymentMethod  PaymentMethod @default(CASH) @map("payment_method")
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  orderStatus    OrderStatus   @default(PENDING) @map("order_status")
  subtotal       Decimal       @default(0) @db.Decimal(10, 2)
  deliveryFee    Decimal       @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  commission     Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @default(0) @db.Decimal(10, 2)
  couponId       String?       @map("coupon_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  items          OrderItem[]
  payment        Payment?
  review         Review?
  statusHistory  OrderStatusHistory[]
  tracking       DeliveryTracking[]

  @@map("orders")
}

model OrderItem {
  id           String   @id @default(uuid())
  order        Order    @relation(fields: [orderId], references: [id])
  orderId      String   @map("order_id")
  product      Product? @relation(fields: [productId], references: [id])
  productId    String?  @map("product_id")
  offer        Offer?   @relation(fields: [offerId], references: [id])
  offerId      String?  @map("offer_id")
  productName  String   @map("product_name")
  productImage String?  @map("product_image")
  quantity     Int      @default(1)
  price        Decimal  @db.Decimal(10, 2)
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String   @map("order_id")
  status    String
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("order_status_history")
}

model DeliveryTracking {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String   @map("order_id")
  lat       Float?
  lng       Float?
  status    String?
  updatedAt DateTime @default(now()) @map("updated_at")

  @@map("delivery_tracking")
}

// ---------------------------------------------------------------------------
// PAYMENTS
// ---------------------------------------------------------------------------

model Payment {
  id              String        @id @default(uuid())
  order           Order         @relation(fields: [orderId], references: [id])
  orderId         String        @unique @map("order_id")
  stripeIntentId  String?       @map("stripe_intent_id")
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime      @default(now()) @map("created_at")

  transactions Transaction[]

  @@map("payments")
}

model Transaction {
  id        String   @id @default(uuid())
  payment   Payment  @relation(fields: [paymentId], references: [id])
  paymentId String   @map("payment_id")
  type      String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("transactions")
}

model StoreSettings {
  id                    String  @id @default(uuid())
  store                 Store   @relation(fields: [storeId], references: [id])
  storeId               String  @unique @map("store_id")
  commissionPercentage  Decimal @default(10) @map("commission_percentage") @db.Decimal(5, 2)
  minimumOrder          Decimal @default(0) @map("minimum_order") @db.Decimal(10, 2)

  @@map("store_settings")
}

model StoreDailyStat {
  id           String   @id @default(uuid())
  store        Store    @relation(fields: [storeId], references: [id])
  storeId      String   @map("store_id")
  date         DateTime @default(now()) @db.Date
  ordersCount  Int      @default(0) @map("orders_count")
  revenue      Decimal  @default(0) @db.Decimal(10, 2)
  commission   Decimal  @default(0) @db.Decimal(10, 2)

  @@unique([storeId, date])
  @@map("store_daily_stats")
}

// ---------------------------------------------------------------------------
// ENGAGEMENT
// ---------------------------------------------------------------------------

model Review {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id")
  store     Store    @relation(fields: [storeId], references: [id])
  storeId   String   @map("store_id")
  order     Order?   @relation(fields: [orderId], references: [id])
  orderId   String?  @unique @map("order_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reviews")
}

model Favorite {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id")
  store     Store?   @relation(fields: [storeId], references: [id])
  storeId   String?  @map("store_id")
  product   Product? @relation(fields: [productId], references: [id])
  productId String?  @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("favorites")
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  discountType   String    @map("discount_type") // "percentage" | "fixed"
  discountValue  Decimal   @map("discount_value") @db.Decimal(10, 2)
  maxUses        Int?      @map("max_uses")
  usedCount      Int       @default(0) @map("used_count")
  minOrderValue  Decimal?  @map("min_order_value") @db.Decimal(10, 2)
  isActive       Boolean   @default(true) @map("is_active")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("coupons")
}

model Notification {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @map("user_id")
  // Free-form category string (not a DB enum) so new notification types
  // don't need a schema migration — e.g. ORDER_STATUS, PROMO, SYSTEM,
  // ADMIN_ANNOUNCEMENT. Client uses it to pick an icon and a deep link.
  type      String   @default("SYSTEM")
  titleAr   String?  @map("title_ar")
  titleEn   String?  @map("title_en")
  bodyAr    String?  @map("body_ar")
  bodyEn    String?  @map("body_en")
  // Deep-link payload, e.g. { "orderId": "..." } — lets the client navigate
  // straight to the relevant screen on tap without guessing from the text.
  data      Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("notifications")
}

model PushToken {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String   @map("user_id")
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@index([userId])
  @@map("push_tokens")
}

// One row per (notification, device) push attempt — lets delivery status
// be tracked per device, not just "we tried to send this notification".
// status: QUEUED | SENT | DELIVERED | FAILED | INVALID_TOKEN
model PushDelivery {
  id           String    @id @default(uuid())
  token        String
  ticketId     String?   @map("ticket_id")
  status       String    @default("QUEUED")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  checkedAt    DateTime? @map("checked_at")

  @@index([status])
  @@map("push_deliveries")
}

model NotificationCampaign {
  id             String    @id @default(uuid())
  title          String
  bodyAr         String    @map("body_ar")
  bodyEn         String?   @map("body_en")
  type           String    @default("PROMO")
  // ALL | ROLE | USER | STORE_CUSTOMERS — kept as a plain string (like
  // Notification.type) rather than a DB enum for the same reason: new
  // targeting options shouldn't need a schema migration.
  targetType     String    @map("target_type")
  targetRole     String?   @map("target_role")
  targetUserId   String?   @map("target_user_id")
  targetStoreId  String?   @map("target_store_id")
  status         String    @default("DRAFT")
  scheduledAt    DateTime? @map("scheduled_at")
  sentAt         DateTime? @map("sent_at")
  recipientCount Int?      @map("recipient_count")
  createdBy      String    @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("notification_campaigns")
}

model Ad {
  id        String    @id @default(uuid())
  store     Store?    @relation(fields: [storeId], references: [id])
  storeId   String?   @map("store_id")
  title     String?
  image     String?
  link      String?
  isActive  Boolean   @default(true) @map("active")
  sortOrder Int       @default(0) @map("sort_order")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Platform-wide ads (storeId null, admin/super-admin only) go straight to
  // APPROVED — review + monthly quota only apply to merchant-created ads.
  approvalStatus  ApprovalStatus @default(PENDING) @map("approval_status")
  rejectionReason String?        @map("rejection_reason")
  reviewedBy      User?          @relation("AdReviewedBy", fields: [reviewedById], references: [id])
  reviewedById    String?        @map("reviewed_by_id")
  reviewedAt      DateTime?      @map("reviewed_at")

  @@index([storeId, createdAt])
  @@index([approvalStatus])
  @@map("ads")
}

model Banner {
  id        String    @id @default(uuid())
  title     String?
  image     String
  link      String?
  isActive  Boolean   @default(true) @map("is_active")
  sortOrder Int       @default(0) @map("sort_order")
  startsAt  DateTime? @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")

  // Optional — lets an admin attribute a homepage banner to the store it's
  // promoting, so the storefront can show "which store is this ad for"
  // instead of just a generic title. Banners remain usable with no store
  // (purely platform/seasonal banners) since this is nullable.
  store   Store?  @relation(fields: [storeId], references: [id])
  storeId String? @map("store_id")

  @@map("banners")
}

model WorkingHour {
  id        String @id @default(uuid())
  store     Store  @relation(fields: [storeId], references: [id])
  storeId   String @map("store_id")
  dayOfWeek Int    @map("day_of_week") // 0-6
  openTime  String @map("open_time")
  closeTime String @map("close_time")
  isClosed  Boolean @default(false) @map("is_closed")

  @@map("working_hours")
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?  @map("user_id")
  action    String
  tableName String   @map("table_name")
  recordId  String?  @map("record_id")
  // Small, structured "what changed" summary — e.g. { before: {...}, after: {...} }
  // or just the fields that changed. Never passwords/tokens/secrets.
  metadata  Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tableName, recordId])
  @@map("audit_logs")
}
