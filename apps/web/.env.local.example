# Must be https (Vercel serves the site over https — an http:// API URL gets
# blocked as mixed content) and must include the /api prefix (lib/api.ts's
# axios calls, e.g. api.get('/districts'), rely on baseURL already having
# it — a bare origin here 404s instead of duplicating /api).
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# OAuth 2.0 Web Client ID from Google Cloud Console — public by design (used
# client-side to load Google Identity Services), NOT a secret. Must be a
# separate "Web application" client ID from the one apps/api's
# GOOGLE_CLIENT_ID may point at if that one is a different client type; both
# can live under the same Google Cloud project.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Sentry (error tracking — optional; a no-op when unset)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Only needed in CI to upload source maps — a plain local/prod build works without it
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
