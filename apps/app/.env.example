# Copy to .env.local for local development (gitignored).
# Not needed for EAS preview/production builds — those get these values
# from the "env" block in eas.json, pointing at Railway.
#
# For local dev against a Nest server running on your machine, replace
# YOUR-LAN-IP with your computer's local network IP (not 127.0.0.1/localhost
# — a physical device or emulator can't reach that). If left unset, the app
# falls back to the IP hardcoded in lib/api.ts / lib/socket.ts.
EXPO_PUBLIC_API_URL=http://YOUR-LAN-IP:4000/api
EXPO_PUBLIC_SOCKET_URL=ws://YOUR-LAN-IP:4000/realtime

# Google Sign-In (optional — GoogleSignInButton renders nothing until at
# least one of these is set). Google issues a separate OAuth client ID per
# platform from Google Cloud Console; these are NOT the same value as
# apps/api's GOOGLE_CLIENT_ID or apps/web's NEXT_PUBLIC_GOOGLE_CLIENT_ID,
# though all can live under one Google Cloud project / consent screen.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
