# ──────────────────────────────────────────────────────────────────────────
# OTLOB mobile — API configuration (all EXPO_PUBLIC_* values are PUBLIC: they
# are inlined into the JS bundle. NEVER put secrets here.)
#
# They are read at Metro bundle time, so after editing this file just restart
# Metro with `npx expo start -c` — no native rebuild is needed.
#
# Copy to .env.local for development. Release builds (EAS preview/production)
# take their values from the profile's `env` block in eas.json instead, and
# IGNORE every LOCAL setting below.
# ──────────────────────────────────────────────────────────────────────────

# PRIMARY API — the deployed (Railway) API, including the /api prefix.
# Optional: falls back to expo.extra.apiBaseUrl in app.json.
EXPO_PUBLIC_API_URL=https://YOUR-RAILWAY-DOMAIN/api
EXPO_PUBLIC_SOCKET_URL=wss://YOUR-RAILWAY-DOMAIN/realtime

# LOCAL API — development builds only; the fallback used when the primary is
# down. OPTIONAL: if unset, the app derives it from the Metro dev server's
# host (port 4000), which already handles a changing LAN IP and the Android
# emulator (10.0.2.2). Set it only when your API runs on a different machine
# or port. Must be reachable FROM THE DEVICE — never "localhost" for a phone.
#   Physical device:  http://<your-computer-LAN-IP>:4000/api   (run `npm run dev:lan-ip` at the repo root)
#   Android emulator: http://10.0.2.2:4000/api
#   iOS simulator:    http://localhost:4000/api
# EXPO_PUBLIC_LOCAL_API_URL=http://192.168.1.100:4000/api
# EXPO_PUBLIC_LOCAL_SOCKET_URL=ws://192.168.1.100:4000/realtime   # derived from the line above when unset

# API MODE — development builds only (release builds always use "primary"):
#   auto     (default) Railway first; fall back to local when Railway is down and
#            local is reachable; return to Railway automatically when it recovers.
#   primary  Railway only — never touch local.
#   local    local only — ignore Railway entirely.
# EXPO_PUBLIC_API_MODE=auto
